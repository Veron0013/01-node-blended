import { model, Schema } from 'mongoose';

const userSchema = new Schema(
  {
    name: {
      type: String,
      required: true,
    },
    price: {
      type: String,
      unique: true,
      required: true,
    },
    password: {
      type: String,
      required: true,
      default: 'other',
    },
  },
  {
    timestamps: true,
    versionKey: false,
  },
);

userSchema.methods.toJSON = function () {
  const obj = this.toObject();
  obj.delete.password;
  return obj;
};
export const User = model('User', userSchema);
